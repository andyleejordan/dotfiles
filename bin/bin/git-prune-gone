#!/usr/bin/env bash
# Copyright 2026 Andy Jordan
set -eu

# Deletes leftover local branches, covering both of my workflows:
#
#   [gone]   the branch had an upstream that has since been deleted,
#            i.e. its pull request was merged and the remote branch
#            reaped
#   merged   the branch was merged into the default branch locally and
#            never pushed at all, so it has no upstream to go missing
#
# Both are only candidates. Nothing is deleted until we have confirmed the
# work is in the default branch, because an upstream also goes [gone] when a
# pull request is closed unmerged or the remote branch is deleted by hand.
#
# With --worktrees, any worktree checked out on such a branch is removed
# first. Dirty worktrees are left alone; git refuses to remove them and
# we keep the branch so nothing is lost. Agent worktrees are left alone
# too, because the agent host owns that lifecycle and a session whose
# checkout disappears underneath it is broken for good.

worktrees=false
dry_run=false
remote=origin

usage() {
    echo "Usage: git prune-gone [--worktrees] [--dry-run] [<remote>]"
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -w|--worktrees) worktrees=true ;;
        -n|--dry-run) dry_run=true ;;
        -h|--help) usage; exit 0 ;;
        -*) usage >&2; exit 1 ;;
        *) remote=$1 ;;
    esac
    shift
done

git fetch --prune --quiet "$remote"

# The default branch is whatever the remote points its HEAD at.
if default=$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD"); then
    default=${default#"$remote/"}
else
    default=$(git config init.defaultBranch || echo main)
fi

# Prefer the local default branch: a merge that has not been pushed yet
# still counts as merged, and it matches what I would see in the log.
if git show-ref --quiet --verify "refs/heads/$default"; then
    base=refs/heads/$default
elif git show-ref --quiet --verify "refs/remotes/$remote/$default"; then
    base=refs/remotes/$remote/$default
else
    echo >&2 "Error: cannot find default branch $default"
    exit 1
fi

current=$(git branch --show-current)
seen=" "

# Prints the worktree path a branch is checked out in, if any.
worktree_for() {
    git worktree list --porcelain |
        awk -v want="branch refs/heads/$1" \
            '/^worktree /{ path = substr($0, 10) } $0 == want { print path }'
}

# Agent sessions park their checkouts in a sibling <repo>.worktrees
# directory (subagents) or under <repo>/.claude/worktrees (desktop app
# sessions) and clean up after themselves when I delete the session.
agent_worktree() {
    local parent
    parent=$(dirname "$1")
    [[ $parent == *.worktrees || $parent == */.claude/worktrees ]]
}

# Succeeds when the branch's work already sits in the base, whether it got
# there as an ancestor (a plain merge or a fast forward) or as a squash. A
# squash rewrites the branch into one unrelated commit, so replay the
# branch's tree onto the merge base and ask git cherry whether that patch
# has already been applied.
merged_into_base() {
    local branch=$1 merge_base tree squashed

    if git merge-base --is-ancestor "$branch" "$base"; then
        return 0
    fi

    merge_base=$(git merge-base "$base" "$branch") || return 1
    tree=$(git rev-parse "$branch^{tree}") || return 1
    squashed=$(git commit-tree "$tree" -p "$merge_base" -m squash) || return 1

    [[ $(git cherry "$base" "$squashed") == -* ]]
}

# prune <branch>
prune() {
    local branch=$1 path

    [[ -n $branch ]] || return 0
    [[ $branch != "$default" ]] || return 0
    [[ $branch != "$current" ]] || return 0
    [[ $seen != *" $branch "* ]] || return 0
    seen="$seen$branch "

    # Settle this before touching the worktree, so a branch we turn out not
    # to be able to delete keeps its checkout as well.
    if ! merged_into_base "$branch"; then
        echo >&2 "Keeping $branch: not merged into $default"
        return 0
    fi

    path=$(worktree_for "$branch")
    if [[ -n $path ]]; then
        if agent_worktree "$path"; then
            echo >&2 "Keeping $branch: agent session worktree $path"
            return 0
        fi
        if ! $worktrees; then
            echo >&2 "Keeping $branch: checked out in $path"
            return 0
        fi
        if $dry_run; then
            echo "Would remove worktree $path"
        elif ! git worktree remove "$path"; then
            return 0
        fi
    fi

    if $dry_run; then
        echo "Would delete branch $branch"
    else
        # -D because a squash merge is not an ancestor; we checked above.
        git branch -D "$branch" || true
    fi
}

# A gone upstream usually means the pull request merged and the remote
# branch was reaped, but it also covers a closed pull request or a remote
# branch I deleted by hand, so these still go through the merge check.
for branch in $(git for-each-ref refs/heads \
    --format='%(if:equals=[gone])%(upstream:track)%(then)%(refname:short)%(end)'); do
    prune "$branch"
done

for branch in $(git for-each-ref refs/heads --merged "$base" \
    --format='%(refname:short)'); do
    prune "$branch"
done

$dry_run || git worktree prune
