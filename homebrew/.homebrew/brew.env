# Read by every brew run, including the daily upgrade launchd starts, which
# never sees the shell's environment. Full cleanup every week, not every 30
# days.
HOMEBREW_CLEANUP_PERIODIC_FULL_DAYS=7
# No "Adjust how often this is run with..." hints, which otherwise repeat in
# every run of the upgrade's log.
HOMEBREW_NO_ENV_HINTS=1
